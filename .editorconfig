# EditorConfig http://EditorConfig.org

# Declare this as the top-most EditorConfig file:
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

[*.http]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2
max_line_length = unset

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
indent_size = 2
max_line_length = 120
